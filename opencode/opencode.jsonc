{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "bash": {
      "*": "allow",
      "*.env*": "deny",
      "git *": "allow",
      "git push *": "ask",
      "rm *": "ask",
      "xargs": "ask",
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.template": "allow",
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.template": "allow",
      "package.json": "ask",
      "package-lock.json": "deny",
      "pnpm-lock.yaml": "deny",
      "pnpm-workspace.yaml": "ask",
      "*.lock": "deny",
      "Makefile": "ask",
    },
  },
}
