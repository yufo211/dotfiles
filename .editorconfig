root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,jsonc,md,yml,yaml}]
indent_style = space
indent_size = 2

# Two trailing spaces are a line break in Markdown, so keep them
[*.md]
trim_trailing_whitespace = false

[{*.lua,Makefile,.gitconfig}]
indent_style = tab
